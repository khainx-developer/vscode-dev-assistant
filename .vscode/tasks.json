{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": [
        "-c",
        "npm run watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[watch\\] build started",
          "endsPattern": "\\[watch\\] build finished"
        }
      },
      "label": "npm: watch (Git Bash)"
    },
    {
      "label": "npm test (Git Bash)",
      "type": "shell",
      "command": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": [
        "-lc",
        "cd /d/my/vscode-dev-assistant; npx tsc -p ./; if [ $? -ne 0 ]; then exit 1; fi; npm test"
      ],
      "isBackground": false,
      "problemMatcher": []
    }
  ]
}