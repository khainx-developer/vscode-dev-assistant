{
  "name": "dev-assistant",
  "displayName": "Dev Assistant",
  "description": "A collection of handy developer utilities for VS Code (private/internal use).",
  "version": "0.0.1",
  "publisher": "internal",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Dev Assistant",
      "properties": {
        "devAssistant.github.monitoredRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub repositories to monitor, as \"owner/repo\"."
        },
        "devAssistant.github.monitoredAuthors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub usernames whose pull requests are tracked as Team PRs."
        },
        "devAssistant.jira.siteUrl": {
          "type": "string",
          "default": "",
          "description": "Jira Cloud site URL, e.g. https://yoursite.atlassian.net."
        },
        "devAssistant.jira.siteId": {
          "type": "string",
          "default": "",
          "description": "Internal: the Jira site's Atlassian cloud ID, set automatically after connecting."
        },
        "devAssistant.jira.currentUser": {
          "type": "string",
          "default": "",
          "description": "Your Jira display name, exactly as it appears on your issues (e.g. the \"assignee\" name). Used to filter \"My Jira Tasks\" on the Daily Tasks dashboard."
        },
        "devAssistant.jira.savedQueries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "jql": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "jql"
            ]
          },
          "default": [],
          "description": "Saved JQL queries used to fetch Jira tasks."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devUtilitiesContainer",
          "title": "Dev Assistant",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "devUtilitiesContainer": [
        {
          "id": "devUtilities.sidebar",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "devUtilities.githubSignIn",
        "title": "Dev Assistant: Sign in to GitHub"
      },
      {
        "command": "devUtilities.openDashboard",
        "title": "Dev Assistant: Open Daily Tasks Dashboard"
      },
      {
        "command": "devUtilities.openJiraDashboard",
        "title": "Dev Assistant: Open Jira Tasks"
      },
      {
        "command": "devUtilities.base64Encode",
        "title": "Dev Assistant: Base64 Encode Selection"
      },
      {
        "command": "devUtilities.base64Decode",
        "title": "Dev Assistant: Base64 Decode Selection"
      },
      {
        "command": "devUtilities.generateUuid",
        "title": "Dev Assistant: Insert UUID"
      },
      {
        "command": "devUtilities.formatJson",
        "title": "Dev Assistant: Format JSON Selection"
      },
      {
        "command": "devUtilities.toJsonEscapedString",
        "title": "Dev Assistant: Escape Selection as JSON String"
      },
      {
        "command": "devUtilities.unixTimestampToDate",
        "title": "Dev Assistant: Convert Unix Timestamp to Date"
      },
      {
        "command": "devUtilities.dateToUnixTimestamp",
        "title": "Dev Assistant: Insert Current Unix Timestamp"
      },
      {
        "command": "devUtilities.toUpperCase",
        "title": "Dev Assistant: Transform to UPPERCASE"
      },
      {
        "command": "devUtilities.toLowerCase",
        "title": "Dev Assistant: Transform to lowercase"
      },
      {
        "command": "devUtilities.toCamelCase",
        "title": "Dev Assistant: Transform to camelCase"
      },
      {
        "command": "devUtilities.toSnakeCase",
        "title": "Dev Assistant: Transform to snake_case"
      },
      {
        "command": "devUtilities.toKebabCase",
        "title": "Dev Assistant: Transform to kebab-case"
      },
      {
        "command": "devUtilities.urlEncode",
        "title": "Dev Assistant: URL Encode Selection"
      },
      {
        "command": "devUtilities.urlDecode",
        "title": "Dev Assistant: URL Decode Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "devUtilities.submenu",
          "group": "9_dev_utilities"
        }
      ],
      "devUtilities.submenu": [
        {
          "command": "devUtilities.base64Encode"
        },
        {
          "command": "devUtilities.base64Decode"
        },
        {
          "command": "devUtilities.generateUuid"
        },
        {
          "command": "devUtilities.formatJson"
        },
        {
          "command": "devUtilities.toJsonEscapedString"
        },
        {
          "command": "devUtilities.unixTimestampToDate"
        },
        {
          "command": "devUtilities.dateToUnixTimestamp"
        },
        {
          "command": "devUtilities.toUpperCase"
        },
        {
          "command": "devUtilities.toLowerCase"
        },
        {
          "command": "devUtilities.toCamelCase"
        },
        {
          "command": "devUtilities.toSnakeCase"
        },
        {
          "command": "devUtilities.toKebabCase"
        },
        {
          "command": "devUtilities.urlEncode"
        },
        {
          "command": "devUtilities.urlDecode"
        }
      ]
    },
    "submenus": [
      {
        "id": "devUtilities.submenu",
        "label": "Dev Assistant"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "lint": "eslint src --ext ts",
    "package": "npm run build && vsce package",
    "test": "vscode-test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^2.29.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.21.5": true,
    "keytar@7.9.0": true
  }
}
