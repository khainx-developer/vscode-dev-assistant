{
  "name": "devmate-kit",
  "displayName": "DevMate Kit",
  "description": "Your daily work radar: GitHub pull requests and Jira tickets that need your attention, right inside VS Code — with optional AI summaries and handy text utilities.",
  "version": "0.1.0",
  "publisher": "khainx-developer",
  "license": "MIT",
  "icon": "media/dev-assistant-activity-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/khainx-developer/vscode-dev-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/khainx-developer/vscode-dev-assistant/issues"
  },
  "homepage": "https://github.com/khainx-developer/vscode-dev-assistant#readme",
  "keywords": [
    "github",
    "pull requests",
    "jira",
    "attention",
    "inbox",
    "dashboard",
    "standup",
    "copilot",
    "ai",
    "productivity",
    "base64",
    "json",
    "uuid"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "DevMate Kit",
      "properties": {
        "devMateKit.ai.provider": {
          "type": "string",
          "enum": [
            "none",
            "vscodeLm",
            "githubCopilot"
          ],
          "enumDescriptions": [
            "AI features are off.",
            "Use language models available in this editor through the VS Code Language Model API (GitHub Copilot, Claude via Copilot or another provider, …).",
            "Deprecated: same as vscodeLm. Kept so existing settings keep working."
          ],
          "default": "none",
          "markdownDescription": "AI runtime for DevMate Kit. `vscodeLm` uses whatever chat models this editor provides — DevMate never stores its own API keys."
        },
        "devMateKit.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "ID of the language model to use. Leave empty to use the first GitHub Copilot model (or the first available model). Pick from the live list with **DevMate Kit: Select AI Model**."
        },
        "devMateKit.github.monitoredRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub repositories to monitor, as \"owner/repo\"."
        },
        "devMateKit.github.monitoredAuthors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub usernames whose pull requests are tracked as Team PRs."
        },
        "devMateKit.jira.siteUrl": {
          "type": "string",
          "default": "",
          "description": "Jira Cloud site URL, e.g. https://yoursite.atlassian.net."
        },
        "devMateKit.jira.siteId": {
          "type": "string",
          "default": "",
          "description": "Internal: the Jira site's Atlassian cloud ID, set automatically after connecting."
        },
        "devMateKit.jira.currentUser": {
          "type": "string",
          "default": "",
          "description": "Your Jira display name, exactly as it appears on your issues (e.g. the \"assignee\" name). Used to filter \"My Jira Tasks\" on the Daily Tasks dashboard."
        },
        "devMateKit.jira.teamMembers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Jira display names of teammates to include in team task monitoring."
        },
        "devMateKit.jira.savedQueries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "jql": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "jql"
            ]
          },
          "default": [],
          "description": "Saved JQL queries used to fetch Jira tasks."
        },
        "devMateKit.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a background refresh finds new items that need your attention."
        },
        "devMateKit.refresh.background": {
          "type": "boolean",
          "default": true,
          "description": "Keep refreshing GitHub and Jira every 10 minutes even when no DevMate view is open (powers the status bar count and notifications)."
        },
        "devMateKit.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the attention count in the status bar."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devMateKitContainer",
          "title": "DevMate Kit",
          "icon": "media/dev-assistant-activity-icon.png"
        }
      ]
    },
    "views": {
      "devMateKitContainer": [
        {
          "id": "devMateKit.sidebar",
          "name": "DevMate Kit",
          "type": "webview",
          "contextualTitle": "DevMate Kit"
        }
      ]
    },
    "commands": [
      {
        "command": "devMateKit.openDashboard",
        "title": "DevMate Kit: Open Daily Tasks Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "devMateKit.refresh",
        "title": "DevMate Kit: Refresh Attention Inbox",
        "icon": "$(refresh)"
      },
      {
        "command": "devMateKit.openSetup",
        "title": "DevMate Kit: Open Setup",
        "icon": "$(gear)"
      },
      {
        "command": "devMateKit.openTools",
        "title": "DevMate Kit: Open Text Tools",
        "icon": "$(tools)"
      },
      {
        "command": "devMateKit.githubSignIn",
        "title": "DevMate Kit: Sign in to GitHub"
      },
      {
        "command": "devMateKit.ai.whatNext",
        "title": "DevMate Kit: Ask AI — What should I do next?",
        "icon": "$(sparkle)"
      },
      {
        "command": "devMateKit.ai.standup",
        "title": "DevMate Kit: Generate Standup Summary",
        "icon": "$(checklist)"
      },
      {
        "command": "devMateKit.ai.selectModel",
        "title": "DevMate Kit: Select AI Model"
      },
      {
        "command": "devMateKit.openTool",
        "title": "DevMate Kit: Open Tool"
      },
      {
        "command": "devMateKit.base64Encode",
        "title": "DevMate Kit: Base64 Encode Selection"
      },
      {
        "command": "devMateKit.base64Decode",
        "title": "DevMate Kit: Base64 Decode Selection"
      },
      {
        "command": "devMateKit.generateUuid",
        "title": "DevMate Kit: Insert UUID"
      },
      {
        "command": "devMateKit.formatJson",
        "title": "DevMate Kit: Format JSON Selection"
      },
      {
        "command": "devMateKit.toJsonEscapedString",
        "title": "DevMate Kit: Escape Selection as JSON String"
      },
      {
        "command": "devMateKit.unixTimestampToDate",
        "title": "DevMate Kit: Convert Unix Timestamp to Date"
      },
      {
        "command": "devMateKit.dateToUnixTimestamp",
        "title": "DevMate Kit: Insert Current Unix Timestamp"
      },
      {
        "command": "devMateKit.toUpperCase",
        "title": "DevMate Kit: Transform to UPPERCASE"
      },
      {
        "command": "devMateKit.toLowerCase",
        "title": "DevMate Kit: Transform to lowercase"
      },
      {
        "command": "devMateKit.toCamelCase",
        "title": "DevMate Kit: Transform to camelCase"
      },
      {
        "command": "devMateKit.toSnakeCase",
        "title": "DevMate Kit: Transform to snake_case"
      },
      {
        "command": "devMateKit.toKebabCase",
        "title": "DevMate Kit: Transform to kebab-case"
      },
      {
        "command": "devMateKit.urlEncode",
        "title": "DevMate Kit: URL Encode Selection"
      },
      {
        "command": "devMateKit.urlDecode",
        "title": "DevMate Kit: URL Decode Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "devMateKit.submenu",
          "group": "9_dev_utilities"
        }
      ],
      "devMateKit.submenu": [
        {
          "command": "devMateKit.base64Encode"
        },
        {
          "command": "devMateKit.base64Decode"
        },
        {
          "command": "devMateKit.generateUuid"
        },
        {
          "command": "devMateKit.formatJson"
        },
        {
          "command": "devMateKit.toJsonEscapedString"
        },
        {
          "command": "devMateKit.unixTimestampToDate"
        },
        {
          "command": "devMateKit.dateToUnixTimestamp"
        },
        {
          "command": "devMateKit.toUpperCase"
        },
        {
          "command": "devMateKit.toLowerCase"
        },
        {
          "command": "devMateKit.toCamelCase"
        },
        {
          "command": "devMateKit.toSnakeCase"
        },
        {
          "command": "devMateKit.toKebabCase"
        },
        {
          "command": "devMateKit.urlEncode"
        },
        {
          "command": "devMateKit.urlDecode"
        }
      ],
      "view/title": [
        {
          "command": "devMateKit.refresh",
          "when": "view == devMateKit.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "devMateKit.openDashboard",
          "when": "view == devMateKit.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "devMateKit.ai.whatNext",
          "when": "view == devMateKit.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "devMateKit.openSetup",
          "when": "view == devMateKit.sidebar",
          "group": "1_setup@1"
        },
        {
          "command": "devMateKit.ai.standup",
          "when": "view == devMateKit.sidebar",
          "group": "2_ai@1"
        },
        {
          "command": "devMateKit.ai.selectModel",
          "when": "view == devMateKit.sidebar",
          "group": "2_ai@2"
        }
      ],
      "commandPalette": [
        {
          "command": "devMateKit.openTool",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "devMateKit.submenu",
        "label": "DevMate Kit"
      }
    ],
    "walkthroughs": [
      {
        "id": "devMateKit.gettingStarted",
        "title": "Get started with DevMate Kit",
        "description": "See the pull requests and Jira tickets that need you — without leaving VS Code.",
        "steps": [
          {
            "id": "signInGitHub",
            "title": "Sign in to GitHub",
            "description": "DevMate uses your VS Code GitHub account to read pull requests.\n[Sign in to GitHub](command:devMateKit.githubSignIn)",
            "media": {
              "markdown": "media/walkthrough/github.md"
            },
            "completionEvents": [
              "onCommand:devMateKit.githubSignIn"
            ]
          },
          {
            "id": "chooseRepos",
            "title": "Choose repositories and teammates",
            "description": "Tell DevMate which repositories and teammates to watch.\n[Open Setup](command:devMateKit.openSetup)",
            "media": {
              "markdown": "media/walkthrough/monitoring.md"
            },
            "completionEvents": [
              "onSettingChanged:devMateKit.github.monitoredRepos"
            ]
          },
          {
            "id": "connectJira",
            "title": "Connect Jira (optional)",
            "description": "Add your Jira tickets and due dates to the inbox.\n[Connect Jira](command:devMateKit.openSetup)",
            "media": {
              "markdown": "media/walkthrough/jira.md"
            },
            "completionEvents": [
              "onSettingChanged:devMateKit.jira.siteUrl"
            ]
          },
          {
            "id": "turnOnAi",
            "title": "Ask AI what to do next (optional)",
            "description": "Use the language models already in your editor, such as GitHub Copilot.\n[Select a model](command:devMateKit.ai.selectModel)",
            "media": {
              "markdown": "media/walkthrough/ai.md"
            },
            "completionEvents": [
              "onSettingChanged:devMateKit.ai.provider"
            ]
          },
          {
            "id": "openDashboard",
            "title": "Open Daily Tasks",
            "description": "Your Attention Inbox, sorted by priority.\n[Open Daily Tasks](command:devMateKit.openDashboard)",
            "media": {
              "markdown": "media/walkthrough/dashboard.md"
            },
            "completionEvents": [
              "onCommand:devMateKit.openDashboard"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "lint": "eslint src --ext ts",
    "package": "npm run build && vsce package",
    "test": "vscode-test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.21.5": true,
    "keytar@7.9.0": true
  }
}
