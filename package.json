{
  "name": "devmate-kit",
  "displayName": "DevMate Kit",
  "description": "A collection of handy developer utilities for VS Code: GitHub PR & Jira task tracking, Base64/URL/JSON tools, UUIDs, timestamps, and case conversions.",
  "version": "0.0.2",
  "publisher": "khainx-developer",
  "license": "MIT",
  "icon": "media/dev-assistant-activity-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/khainx-developer/vscode-dev-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/khainx-developer/vscode-dev-assistant/issues"
  },
  "homepage": "https://github.com/khainx-developer/vscode-dev-assistant#readme",
  "keywords": [
    "github",
    "jira",
    "base64",
    "uuid",
    "json",
    "productivity",
    "utilities"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "DevMate Kit",
      "properties": {
        "devMateKit.ai.provider": {
          "type": "string",
          "enum": [
            "none",
            "githubCopilot"
          ],
          "enumDescriptions": [
            "Do not use an AI provider.",
            "Use GitHub Copilot as the AI runtime."
          ],
          "default": "none",
          "description": "AI runtime used by DevMate Kit."
        },
        "devMateKit.ai.model": {
          "type": "string",
          "default": "GPT-6 Luna",
          "description": "GitHub Copilot model ID used by the AI runtime. The available model list is provided by VS Code."
        },
        "devMateKit.github.monitoredRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub repositories to monitor, as \"owner/repo\"."
        },
        "devMateKit.github.monitoredAuthors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "GitHub usernames whose pull requests are tracked as Team PRs."
        },
        "devMateKit.jira.siteUrl": {
          "type": "string",
          "default": "",
          "description": "Jira Cloud site URL, e.g. https://yoursite.atlassian.net."
        },
        "devMateKit.jira.siteId": {
          "type": "string",
          "default": "",
          "description": "Internal: the Jira site's Atlassian cloud ID, set automatically after connecting."
        },
        "devMateKit.jira.currentUser": {
          "type": "string",
          "default": "",
          "description": "Your Jira display name, exactly as it appears on your issues (e.g. the \"assignee\" name). Used to filter \"My Jira Tasks\" on the Daily Tasks dashboard."
        },
        "devMateKit.jira.teamMembers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Jira display names of teammates to include in team task monitoring."
        },
        "devMateKit.jira.savedQueries": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "jql": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "jql"
            ]
          },
          "default": [],
          "description": "Saved JQL queries used to fetch Jira tasks."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devMateKitContainer",
          "title": "DevMate Kit",
          "icon": "media/dev-assistant-activity-icon.png"
        }
      ]
    },
    "views": {
      "devMateKitContainer": [
        {
          "id": "devMateKit.sidebar",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "devMateKit.githubSignIn",
        "title": "DevMate Kit: Sign in to GitHub"
      },
      {
        "command": "devMateKit.openDashboard",
        "title": "DevMate Kit: Open Daily Tasks Dashboard"
      },
      {
        "command": "devMateKit.base64Encode",
        "title": "DevMate Kit: Base64 Encode Selection"
      },
      {
        "command": "devMateKit.base64Decode",
        "title": "DevMate Kit: Base64 Decode Selection"
      },
      {
        "command": "devMateKit.generateUuid",
        "title": "DevMate Kit: Insert UUID"
      },
      {
        "command": "devMateKit.formatJson",
        "title": "DevMate Kit: Format JSON Selection"
      },
      {
        "command": "devMateKit.toJsonEscapedString",
        "title": "DevMate Kit: Escape Selection as JSON String"
      },
      {
        "command": "devMateKit.unixTimestampToDate",
        "title": "DevMate Kit: Convert Unix Timestamp to Date"
      },
      {
        "command": "devMateKit.dateToUnixTimestamp",
        "title": "DevMate Kit: Insert Current Unix Timestamp"
      },
      {
        "command": "devMateKit.toUpperCase",
        "title": "DevMate Kit: Transform to UPPERCASE"
      },
      {
        "command": "devMateKit.toLowerCase",
        "title": "DevMate Kit: Transform to lowercase"
      },
      {
        "command": "devMateKit.toCamelCase",
        "title": "DevMate Kit: Transform to camelCase"
      },
      {
        "command": "devMateKit.toSnakeCase",
        "title": "DevMate Kit: Transform to snake_case"
      },
      {
        "command": "devMateKit.toKebabCase",
        "title": "DevMate Kit: Transform to kebab-case"
      },
      {
        "command": "devMateKit.urlEncode",
        "title": "DevMate Kit: URL Encode Selection"
      },
      {
        "command": "devMateKit.urlDecode",
        "title": "DevMate Kit: URL Decode Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "devMateKit.submenu",
          "group": "9_dev_utilities"
        }
      ],
      "devMateKit.submenu": [
        {
          "command": "devMateKit.base64Encode"
        },
        {
          "command": "devMateKit.base64Decode"
        },
        {
          "command": "devMateKit.generateUuid"
        },
        {
          "command": "devMateKit.formatJson"
        },
        {
          "command": "devMateKit.toJsonEscapedString"
        },
        {
          "command": "devMateKit.unixTimestampToDate"
        },
        {
          "command": "devMateKit.dateToUnixTimestamp"
        },
        {
          "command": "devMateKit.toUpperCase"
        },
        {
          "command": "devMateKit.toLowerCase"
        },
        {
          "command": "devMateKit.toCamelCase"
        },
        {
          "command": "devMateKit.toSnakeCase"
        },
        {
          "command": "devMateKit.toKebabCase"
        },
        {
          "command": "devMateKit.urlEncode"
        },
        {
          "command": "devMateKit.urlDecode"
        }
      ]
    },
    "submenus": [
      {
        "id": "devMateKit.submenu",
        "label": "DevMate Kit"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "lint": "eslint src --ext ts",
    "package": "npm run build && vsce package",
    "test": "vscode-test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^2.29.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.21.5": true,
    "keytar@7.9.0": true
  }
}
